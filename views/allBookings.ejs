<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Guest Bookings</h2>
            <p class="text-muted mb-0">
                Manage all hotel bookings
            </p>
        </div>

        <span class="badge bg-primary fs-6">
            <%= booking.length %> Bookings
        </span>
    </div>

    <% if (!booking || booking.length === 0) { %>
        <div class="card shadow-sm border-0">
            <div class="card-body text-center py-5">
                <div class="fs-1 mb-3">📭</div>
                <h4>No Bookings Found</h4>
                <p class="text-muted">
                    There are currently no guest bookings.
                </p>
            </div>
        </div>
    <% } else { %>
        <div class="card shadow-sm border-0">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>#</th>
                                <th>Booking ID</th>
                                <th>Check-In</th>
                                <th>Check-Out</th>
                                <th>Guests</th>
                                <th>Price/Night</th>
                                <th>Total Amount</th>
                                <th>Status</th>
                                <th>Action</th>
                            </tr>
                        </thead>

                        <tbody>
                            <% booking.forEach((item, index) => { %>
                                <tr>
                                    <td>
                                        <%= index + 1 %>
                                    </td>

                                    <td>
                                        <small class="text-muted">
                                            <%= item._id %>
                                        </small>
                                    </td>

                                    <td>
                                        <%= new Date(item.checkIn).toLocaleDateString("en-IN") %>
                                    </td>

                                    <td>
                                        <%= new Date(item.checkOut).toLocaleDateString("en-IN") %>
                                    </td>

                                    <td>
                                        👤 <%= item.guests %>
                                    </td>

                                    <td>
                                        ₹<%= item.pricePerNight %>
                                    </td>

                                    <td class="fw-bold">
                                        ₹<%= item.totalAmount %>
                                    </td>

                                    <td>
                                        <% if (item.status === "Confirmed") { %>
                                            <span class="badge bg-success">
                                                Confirmed
                                            </span>
                                        <% } else if (item.status === "Pending") { %>
                                            <span class="badge bg-warning text-dark">
                                                Pending
                                            </span>
                                        <% } else if (item.status === "Cancelled") { %>
                                            <span class="badge bg-danger">
                                                Cancelled
                                            </span>
                                        <% } else if (item.status === "Completed") { %>
                                            <span class="badge bg-secondary">
                                                Completed
                                            </span>
                                        <% } %>
                                    </td>

                                    <td>
                                        <a
                                            href="/api/booking/<%= item._id %>"
                                            class="btn btn-sm btn-primary"
                                        >
                                            View
                                        </a>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    <% } %>
</div>