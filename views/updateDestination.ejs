<div class="container-fluid">
    <div class="mb-4">
        <h2 class="fw-bold mb-1">Update Destination</h2>
        <p class="text-muted mb-0">Update travel destination information.</p>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-4">
            <form
                action="/api/travel/update/<%= destination._id %>"
                method="POST"
                enctype="multipart/form-data"
            >
                <div class="mb-3">
                    <label class="form-label fw-semibold">Category</label>
                    <select name="category" class="form-select">
                        <option value="">Select Category</option>
                        <option
                            value="Heritage cuisine trails"
                            <%= destination.category === "Heritage cuisine trails" ? "selected" : "" %>
                        >
                            Heritage cuisine trails
                        </option>
                        <option
                            value="Hill stations and mountains"
                            <%= destination.category === "Hill stations and mountains" ? "selected" : "" %>
                        >
                            Hill stations and mountains
                        </option>
                        <option
                            value="Cities and cafes"
                            <%= destination.category === "Cities and cafes" ? "selected" : "" %>
                        >
                            Cities and cafes
                        </option>
                    </select>

                    <% if (errors) { %>
                        <% errors.forEach(error => { %>
                            <% if (error.path === "category") { %>
                                <small class="text-danger"><%= error.msg %></small>
                            <% } %>
                        <% }) %>
                    <% } %>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Country</label>
                    <input
                        type="text"
                        name="country"
                        class="form-control"
                        value="<%= destination.country %>"
                    >

                    <% if (errors) { %>
                        <% errors.forEach(error => { %>
                            <% if (error.path === "country") { %>
                                <small class="text-danger"><%= error.msg %></small>
                            <% } %>
                        <% }) %>
                    <% } %>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">City / Destination</label>
                    <input
                        type="text"
                        name="city"
                        class="form-control"
                        value="<%= destination.city %>"
                    >

                    <% if (errors) { %>
                        <% errors.forEach(error => { %>
                            <% if (error.path === "city") { %>
                                <small class="text-danger"><%= error.msg %></small>
                            <% } %>
                        <% }) %>
                    <% } %>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold d-block">Current Image</label>

                    <% if (destination.image) { %>
                        <img
                            src="/uploads/<%= destination.image %>"
                            alt="<%= destination.city %>"
                            class="rounded mb-2"
                            style="width:180px;height:120px;object-fit:cover;"
                        >
                    <% } else { %>
                        <p class="text-muted">No image available.</p>
                    <% } %>
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold">Change Image</label>
                    <input
                        type="file"
                        name="image"
                        class="form-control"
                        accept="image/*"
                    >
                    <small class="text-muted">
                        Leave empty if you want to keep the current image.
                    </small>
                </div>

                <div class="form-check mb-4">
                    <input
                        type="checkbox"
                        name="isActive"
                        value="true"
                        class="form-check-input"
                        id="isActive"
                        <%= destination.isActive ? "checked" : "" %>
                    >
                    <label class="form-check-label" for="isActive">
                        Active Destination
                    </label>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-dark">
                        <i class="bi bi-check-circle me-2"></i>
                        Update Destination
                    </button>

                    <a href="/api/travel" class="btn btn-outline-secondary">
                        Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>