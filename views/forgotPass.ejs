<div class="container-fluid min-vh-100 d-flex align-items-center justify-content-center bg-light">
    <div class="row shadow-lg rounded-4 overflow-hidden bg-white" style="max-width:1100px;width:100%;">

        <!-- Left Hotel Branding -->
        <div class="col-lg-5 d-none d-lg-flex align-items-center justify-content-center bg-dark text-white p-5">
            <div class="text-center">
                <i class="bi bi-building fs-1 text-warning"></i>
                <h1 class="fw-bold mt-3">Luxury Stay</h1>
                <p class="text-white-50">
                    Reset your password and continue your journey with premium hospitality.
                </p>

                <hr class="border-light">

                <div class="mt-4">
                    <p><i class="bi bi-lock-fill text-warning"></i> Secure Account Recovery</p>
                    <p><i class="bi bi-envelope-check text-warning"></i> Email Verification</p>
                    <p><i class="bi bi-shield-check text-warning"></i> Protected Information</p>
                </div>
            </div>
        </div>

        <!-- Forgot Password Form -->
        <div class="col-lg-7 p-5">
            <div class="text-center mb-4">
                <i class="bi bi-key-fill fs-1 text-warning"></i>
                <h2 class="fw-bold mt-3">Forgot Password?</h2>
                <p class="text-muted">
                    Enter your registered email and we will send you a password reset link.
                </p>
            </div>

            <% if (errors && errors.length > 0) { %>
                <div class="alert alert-danger rounded-3">
                    <% errors.forEach(error => { %>
                        <div>
                            <i class="bi bi-exclamation-circle"></i>
                            <%= error.msg %>
                        </div>
                    <% }) %>
                </div>
            <% } %>

            <form action="/api/auth/forgot-pass" method="POST">
                <div class="mb-4">
                    <label class="form-label fw-semibold">Email Address</label>
                    <input
                        type="email"
                        class="form-control form-control-lg rounded-3"
                        name="email"
                        value="<%= oldData?.email || '' %>"
                        placeholder="Enter your registered email"
                    >
                </div>

                <div class="d-grid">
                    <button type="submit" class="btn btn-warning rounded-pill py-2 fw-bold">
                        <i class="bi bi-send"></i>
                        Send Reset Link
                    </button>
                </div>
            </form>

            <hr class="my-4">

            <p class="text-center mb-0">
                Remember your password?
                <a href="/api/auth/login" class="text-warning fw-bold text-decoration-none">
                    Back To Login
                </a>
            </p>
        </div>

    </div>
</div>