<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
    <title>Register Page</title>
</head>
<body>

<div class="container mt-5">
    <h1>Register Page</h1>

    <form action="/api/auth/register" method="POST" enctype="multipart/form-data">

        <!-- Image -->
        <div class="mb-3">
            <label>Profile Image</label>
            <input type="file" name="image" class="form-control">
        </div>

        <!-- Name -->
        <div class="mb-3">
            <label>Name</label>
            <input
                type="text"
                name="name"
                class="form-control"
                value="<%= oldData.name || '' %>"
            >

            <% errors.forEach(error=>{ %>
                <% if(error.path==="name"){ %>
                    <small class="text-danger"><%= error.msg %></small>
                <% } %>
            <% }) %>
        </div>

        <!-- Email -->
        <div class="mb-3">
            <label>Email</label>
            <input
                type="email"
                name="email"
                class="form-control"
                value="<%= oldData.email || '' %>"
            >

            <% errors.forEach(error=>{ %>
                <% if(error.path==="email"){ %>
                    <small class="text-danger"><%= error.msg %></small>
                <% } %>
            <% }) %>
        </div>

        <!-- Phone -->
        <div class="mb-3">
            <label>Phone</label>
            <input
                type="text"
                name="phoneNo"
                class="form-control"
                value="<%= oldData.phoneNo || '' %>"
            >

            <% errors.forEach(error=>{ %>
                <% if(error.path==="phoneNo"){ %>
                    <small class="text-danger"><%= error.msg %></small>
                <% } %>
            <% }) %>
        </div>

        <!-- Password -->
        <div class="mb-3">
            <label>Password</label>
            <input
                type="password"
                name="password"
                class="form-control"
            >

            <% errors.forEach(error=>{ %>
                <% if(error.path==="password"){ %>
                    <small class="text-danger"><%= error.msg %></small>
                <% } %>
            <% }) %>
        </div>

        <!-- Confirm Password -->
        <div class="mb-3">
            <label>Confirm Password</label>
            <input
                type="password"
                name="confirmPassword"
                class="form-control"
            >

            <% errors.forEach(error=>{ %>
                <% if(error.msg==="Passwords do not match"){ %>
                    <small class="text-danger"><%= error.msg %></small>
                <% } %>
            <% }) %>
        </div>
<div class="mb-3">
    <label for="role" class="form-label">Role</label>
    <select name="role" id="role" class="form-control">
        <option value="">Select Role</option>
        <option value="Customer">Customer</option>
        <option value="Seller">Seller</option>
    </select>
</div>
        <button class="btn btn-warning">Register</button>

    </form>
</div>

</body>
</html>