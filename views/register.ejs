<div class="container-fluid min-vh-100 d-flex align-items-center justify-content-center bg-light py-5">
    <div class="row shadow-lg rounded-4 overflow-hidden bg-white"
         style="max-width:1100px; width:100%;">

        <!-- Left Hotel Branding -->
        <div class="col-lg-5 d-none d-lg-flex align-items-center justify-content-center bg-dark text-white p-5">
            <div class="text-center">
                <i class="bi bi-building fs-1 text-warning"></i>

                <h1 class="fw-bold mt-3">
                    Welcome To Luxury Stay
                </h1>

                <p class="text-white-50 mt-3">
                    Create your account and experience
                    premium hotel booking with comfort,
                    elegance and security.
                </p>

                <hr class="border-light">

                <div class="mt-4">
                    <p>
                        <i class="bi bi-check-circle-fill text-warning"></i>
                        Easy Room Booking
                    </p>

                    <p>
                        <i class="bi bi-check-circle-fill text-warning"></i>
                        Exclusive Hotel Offers
                    </p>

                    <p>
                        <i class="bi bi-check-circle-fill text-warning"></i>
                        Secure Payments
                    </p>

                    <p>
                        <i class="bi bi-check-circle-fill text-warning"></i>
                        Premium Guest Experience
                    </p>
                </div>
            </div>
        </div>

        <!-- Register Form -->
        <div class="col-lg-7 p-5">
            <div class="text-center mb-4">
                <i class="bi bi-person-plus-fill fs-1 text-warning"></i>

                <h2 class="fw-bold mt-3">
                    Create Account
                </h2>

                <p class="text-muted">
                    Join our hotel community today
                </p>
            </div>

            <form action="/api/auth/register"
                  method="POST"
                  enctype="multipart/form-data">

                <div class="row">

                    <!-- Profile Image -->
                    <div class="col-12 mb-3">
                        <label class="form-label fw-semibold">
                            Profile Image
                        </label>

                        <div class="input-group">
                            <span class="input-group-text bg-warning">
                                <i class="bi bi-image"></i>
                            </span>

                            <input
                                type="file"
                                name="image"
                                class="form-control"
                            >
                        </div>
                    </div>

                    <!-- Name -->
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-semibold">
                            Full Name
                        </label>

                        <input
                            type="text"
                            name="name"
                            class="form-control rounded-3"
                            placeholder="Enter your name"
                            value="<%= oldData.name || '' %>"
                        >

                        <% errors.forEach(error => { %>
                            <% if (error.path === "name") { %>
                                <small class="text-danger">
                                    <%= error.msg %>
                                </small>
                            <% } %>
                        <% }) %>
                    </div>

                    <!-- Email -->
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-semibold">
                            Email Address
                        </label>

                        <input
                            type="email"
                            name="email"
                            class="form-control rounded-3"
                            placeholder="example@gmail.com"
                            value="<%= oldData.email || '' %>"
                        >

                        <% errors.forEach(error => { %>
                            <% if (error.path === "email") { %>
                                <small class="text-danger">
                                    <%= error.msg %>
                                </small>
                            <% } %>
                        <% }) %>
                    </div>

                    <!-- Phone -->
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-semibold">
                            Phone Number
                        </label>

                        <input
                            type="text"
                            name="phoneNo"
                            class="form-control rounded-3"
                            placeholder="Enter mobile number"
                            value="<%= oldData.phoneNo || '' %>"
                        >

                        <% errors.forEach(error => { %>
                            <% if (error.path === "phoneNo") { %>
                                <small class="text-danger">
                                    <%= error.msg %>
                                </small>
                            <% } %>
                        <% }) %>
                    </div>

                    <!-- Role -->
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-semibold">
                            Account Type
                        </label>

                        <select name="role" class="form-select rounded-3">
                            <option value="">
                                Select Role
                            </option>

                            <option value="Guest"
                                <%= oldData.role === "Guest" ? "selected" : "" %>>
                                Guest
                            </option>

                            <option value="Admin"
                                <%= oldData.role === "Admin" ? "selected" : "" %>>
                                Admin
                            </option>
                        </select>

                        <% errors.forEach(error => { %>
                            <% if (error.path === "role") { %>
                                <small class="text-danger">
                                    <%= error.msg %>
                                </small>
                            <% } %>
                        <% }) %>
                    </div>

                    <!-- Password -->
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-semibold">
                            Password
                        </label>

                        <input
                            type="password"
                            name="password"
                            class="form-control rounded-3"
                            placeholder="Create password"
                        >

                        <% errors.forEach(error => { %>
                            <% if (error.path === "password") { %>
                                <small class="text-danger">
                                    <%= error.msg %>
                                </small>
                            <% } %>
                        <% }) %>
                    </div>

                    <!-- Confirm Password -->
                    <div class="col-md-6 mb-3">
                        <label class="form-label fw-semibold">
                            Confirm Password
                        </label>

                        <input
                            type="password"
                            name="confirmPassword"
                            class="form-control rounded-3"
                            placeholder="Confirm password"
                        >

                        <% errors.forEach(error => { %>
                            <% if (error.path === "confirmPassword") { %>
                                <small class="text-danger">
                                    <%= error.msg %>
                                </small>
                            <% } %>
                        <% }) %>
                    </div>

                </div>

                <!-- Submit -->
                <div class="d-grid">
                    <button
                        type="submit"
                        class="btn btn-warning rounded-pill py-2 fw-bold">
                        <i class="bi bi-person-check"></i>
                        Create Account
                    </button>
                </div>

                <div class="text-center mt-4">
                    <small class="text-muted">
                        <i class="bi bi-shield-check text-warning"></i>
                        Your information is secured with us
                    </small>
                </div>

                <p class="text-center mt-4 mb-0 text-muted">
                    Already have an account?
                    <a href="/api/auth/login"
                       class="text-warning fw-bold text-decoration-none">
                        Login
                    </a>
                </p>

            </form>
        </div>

    </div>
</div>