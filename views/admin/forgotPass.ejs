<div class="container-fluid min-vh-100 d-flex align-items-center justify-content-center bg-light">

    <div class="card shadow-lg border-0 rounded-4 overflow-hidden" style="max-width:850px; width:100%;">

        <div class="row g-0">

            <!-- Left Side -->
            <div class="col-lg-5 bg-dark text-white d-flex flex-column justify-content-center p-5">

                <div class="text-center">
                    <i class="bi bi-shield-lock-fill display-4 text-warning"></i>

                    <h2 class="fw-bold mt-3">Admin Portal</h2>

                    <p class="text-white-50">
                        Manage hotels, rooms, bookings and customers from one secure dashboard.
                    </p>

                    <hr class="border-secondary">

                    <p><i class="bi bi-building text-warning"></i> Hotel Management</p>
                    <p><i class="bi bi-calendar-check text-warning"></i> Booking Management</p>
                    <p><i class="bi bi-people text-warning"></i> Customer Management</p>
                </div>

            </div>

            <!-- Right Side -->
            <div class="col-lg-7 p-5">

                <div class="text-center mb-4">
                    <i class="bi bi-person-plus-fill fs-1 text-warning"></i>

                    <h3 class="fw-bold mt-2">Forgot Password</h3>

                </div>

                <form action="/api/admin/forgotPass"
                      method="POST"
                      >

                   

                    <div class="mb-3">
                        <label class="form-label">Email Address</label>
                        <input type="email"
                               name="email"
                               class="form-control"
                               placeholder="admin@example.com">
                                                   <% if(errors){ %>

                        <% errors.forEach(error=>{ %>

                            <% if(error.path==="email"){ %>

                                <small class="text-danger">
                                    <%= error.msg %>
                                </small>

                            <% } %>

                        <% }) %>

                    <% } %>



                    </div>

                    

                    <button class="btn btn-warning w-100 fw-bold rounded-pill py-2">
                        <i class="bi bi-person-check-fill"></i>
                        Reset Link
                    </button>

                    <p class="text-center mt-4 mb-0 text-muted">
                        Remember Password?
                        <a href="/api/admin/login"
                        
                           class="text-warning fw-bold text-decoration-none">
                            Login
                        </a>
                    </p>
                </form>

            </div>

        </div>

    </div>

</div>