<div class="container-fluid">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Update Hotel</h2>
            <p class="text-muted mb-0">Update hotel information</p>
        </div>

        <a href="/api/admin/hotel" class="btn btn-outline-dark">
            <i class="bi bi-arrow-left me-2"></i>
            Back to Hotels
        </a>
    </div>

    <!-- Update Hotel Card -->
    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">
            <form action="/api/admin/hotel/update/<%= hotel._id %>" method="POST" enctype="multipart/form-data">
                <div class="row g-4">

                    <!-- Hotel Name -->
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Hotel Name</label>
                        <input type="text" name="name" class="form-control"
                            value="<%= hotel.name %>" placeholder="Enter hotel name">

                        <% if (errors) { %>
                            <% errors.forEach(error => { %>
                                <% if (error.path === "name") { %>
                                    <small class="text-danger"><%= error.msg %></small>
                                <% } %>
                            <% }) %>
                        <% } %>
                    </div>

                    <!-- Phone -->
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Phone</label>
                        <input type="text" name="phone" class="form-control"
                            value="<%= hotel.phone %>" placeholder="Enter phone number">

                        <% if (errors) { %>
                            <% errors.forEach(error => { %>
                                <% if (error.path === "phone") { %>
                                    <small class="text-danger"><%= error.msg %></small>
                                <% } %>
                            <% }) %>
                        <% } %>
                    </div>

                    <!-- Email -->
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Email</label>
                        <input type="email" name="email" class="form-control"
                            value="<%= hotel.email %>" placeholder="Enter email">

                        <% if (errors) { %>
                            <% errors.forEach(error => { %>
                                <% if (error.path === "email") { %>
                                    <small class="text-danger"><%= error.msg %></small>
                                <% } %>
                            <% }) %>
                        <% } %>
                    </div>

                    <!-- Address -->
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Address</label>
                        <input type="text" name="address" class="form-control"
                            value="<%= hotel.address %>" placeholder="Enter hotel address">

                        <% if (errors) { %>
                            <% errors.forEach(error => { %>
                                <% if (error.path === "address") { %>
                                    <small class="text-danger"><%= error.msg %></small>
                                <% } %>
                            <% }) %>
                        <% } %>
                    </div>

                    <!-- Description -->
                    <div class="col-12">
                        <label class="form-label fw-semibold">Hotel Description</label>
                        <textarea name="desc" class="form-control" rows="5"
                            placeholder="Enter hotel description"><%= hotel.desc %></textarea>

                        <% if (errors) { %>
                            <% errors.forEach(error => { %>
                                <% if (error.path === "desc") { %>
                                    <small class="text-danger"><%= error.msg %></small>
                                <% } %>
                            <% }) %>
                        <% } %>
                    </div>

                    <!-- Check In -->
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Check-in Time</label>
                        <input type="time" name="checkInTime" class="form-control"
                            value="<%= hotel.checkInTime %>">

                        <% if (errors) { %>
                            <% errors.forEach(error => { %>
                                <% if (error.path === "checkInTime") { %>
                                    <small class="text-danger"><%= error.msg %></small>
                                <% } %>
                            <% }) %>
                        <% } %>
                    </div>

                    <!-- Check Out -->
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Check-out Time</label>
                        <input type="time" name="checkOutTime" class="form-control"
                            value="<%= hotel.checkOutTime %>">

                        <% if (errors) { %>
                            <% errors.forEach(error => { %>
                                <% if (error.path === "checkOutTime") { %>
                                    <small class="text-danger"><%= error.msg %></small>
                                <% } %>
                            <% }) %>
                        <% } %>
                    </div>

                    <!-- Status -->
                    <div class="col-md-4">
                        <label class="form-label fw-semibold">Status</label>
                        <select name="status" class="form-select">
                            <option value="Active" <%= hotel.status === "Active" ? "selected" : "" %>>
                                Active
                            </option>
                            <option value="Inactive" <%= hotel.status === "Inactive" ? "selected" : "" %>>
                                Inactive
                            </option>
                        </select>
                    </div>

                    <!-- Current Image -->
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Current Hotel Image</label>

                        <div class="mt-2">
                            <% if (hotel.hotelImage) { %>
                                <img
                                    src="/uploads/<%= hotel.hotelImage %>"
                                    alt="<%= hotel.name %>"
                                    class="rounded border"
                                    style="width:220px;height:140px;object-fit:cover;"
                                >
                            <% } else { %>
                                <p class="text-muted">No image available</p>
                            <% } %>
                        </div>
                    </div>

                    <!-- New Image -->
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Change Hotel Image</label>

                        <input
                            type="file"
                            name="hotelImage"
                            class="form-control"
                            accept="image/*"
                        >

                        <small class="text-muted">
                            Leave empty to keep the current image.
                        </small>
                    </div>

                    <!-- Buttons -->
                    <div class="col-12">
                        <hr>

                        <div class="d-flex justify-content-end gap-2">
                            <a href="/api/admin/hotel" class="btn btn-light border">
                                Cancel
                            </a>

                            <button type="submit" class="btn btn-dark px-4">
                                <i class="bi bi-check-circle me-2"></i>
                                Update Hotel
                            </button>
                        </div>
                    </div>

                </div>
            </form>
        </div>
    </div>
</div>