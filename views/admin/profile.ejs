<!-- Header -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">Admin Profile</h2>
        <p class="text-muted mb-0">Manage your administrator account information.</p>
    </div>
    <a href="/api/admin/dashboard" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i>Dashboard
    </a>
</div>

<!-- Profile -->
<div class="row g-4">

    <!-- Admin Identity -->
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body text-center p-4">

                <% if (user?.image) { %>
                    <img src="/uploads/<%= user.image %>" alt="Admin Profile"
                         class="rounded-circle mx-auto mb-3 d-block"
                         style="width:120px;height:120px;object-fit:cover;border:4px solid #f1f3f5;">
                <% } else { %>
                    <div class="rounded-circle bg-dark text-white d-flex align-items-center justify-content-center mx-auto mb-3"
                         style="width:120px;height:120px;font-size:45px;">
                        <i class="bi bi-person-gear"></i>
                    </div>
                <% } %>

                <h4 class="fw-bold mb-1"><%= user?.name || "Administrator" %></h4>
                <p class="text-muted mb-3"><%= user?.email || "No email available" %></p>

                <span class="badge bg-dark px-3 py-2">
                    <i class="bi bi-shield-check me-1"></i>Administrator
                </span>

            </div>
        </div>
    </div>

    <!-- Admin Information -->
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm">
            <div class="card-body p-4">

                <h5 class="fw-bold mb-4">Account Information</h5>

                <form action="/api/admin/profile/update" method="POST" enctype="multipart/form-data">
                    <div class="row g-3">

                        <!-- Name -->
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Full Name</label>
                            <input type="text" name="name" class="form-control"
                                   value="<%= user?.name || '' %>"
                                   placeholder="Enter admin name" required>
                        </div>

                        <!-- Email -->
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Email Address</label>
                            <input type="email" class="form-control"
                                   value="<%= user?.email || '' %>" readonly>
                            <small class="text-muted">Email cannot be changed.</small>
                        </div>

                        <!-- Role -->
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Role</label>
                            <input type="text" class="form-control" value="Administrator" readonly>
                        </div>

                        <!-- Profile Image -->
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Profile Image</label>
                            <input type="file" name="image" class="form-control"
                                   accept="image/png,image/jpeg,image/jpg,image/webp">
                            <small class="text-muted">JPG, JPEG, PNG or WEBP.</small>
                        </div>

                    </div>

                    <hr class="my-4">

                    <div class="d-flex justify-content-end gap-2">
                        <a href="/api/admin/dashboard" class="btn btn-light border">Cancel</a>
                        <button type="submit" class="btn btn-dark px-4">
                            <i class="bi bi-check-lg me-1"></i>Save Changes
                        </button>
                    </div>
                </form>

            </div>
        </div>
    </div>
</div>

<!-- Account & Security -->
<div class="card border-0 shadow-sm mt-4">
    <div class="card-body p-4">

        <h5 class="fw-bold mb-3">Account & Security</h5>

        <div class="row g-3">

            <div class="col-md-4">
                <a href="/api/admin/dashboard" class="btn btn-outline-dark w-100 py-2">
                    <i class="bi bi-speedometer2 me-2"></i>Dashboard
                </a>
            </div>


            <div class="col-md-4">
                <form action="/api/admin/logout" method="get">
                    <button type="submit" class="btn btn-outline-danger w-100 py-2">
                        <i class="bi bi-box-arrow-right me-2"></i>Logout
                    </button>
                </form>
            </div>

        </div>
    </div>
</div>
