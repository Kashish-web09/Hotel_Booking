<div class="container-fluid py-4">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Hotels</h2>
            <p class="text-muted mb-0">Manage your hotels</p>
        </div>

        <a href="/api/admin/hotel/add" class="btn btn-dark">
            <i class="bi bi-plus-circle me-2"></i>
            Add Hotel
        </a>
    </div>


    <!-- Hotels Table -->
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">

            <% if (hotels?.length) { %>

                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">

                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">Hotel</th>
                                <th>Location</th>
                                <th>Contact</th>
                                <th>Check In</th>
                                <th>Check Out</th>
                                <th>Status</th>
                                <th class="text-end pe-4">Actions</th>
                            </tr>
                        </thead>

                        <tbody>
                            <% hotels.forEach(hotel => { %>

                                <tr>

<!-- Hotel -->
<td class="ps-4">
    <div class="d-flex align-items-center gap-3">

        <% if (hotel.hotelImage) { %>

            <img
                src="/uploads/<%= hotel.hotelImage %>"
                alt="<%= hotel.name %>"
                width="60"
                height="50"
                class="rounded"
                style="object-fit: cover;"
            >

        <% } else { %>

            <img
                src="/images/hotel1.jpg"
                alt="Hotel"
                width="60"
                height="50"
                class="rounded"
                style="object-fit: cover;"
            >

        <% } %>

        <div>
            <div class="fw-semibold">
                <%= hotel.name %>
            </div>

            <small class="text-muted">
                <%= hotel.country %>
            </small>
        </div>

    </div>
</td>


                                    <!-- Location -->
                                    <td>
                                        <%= hotel.city %>, <%= hotel.state %>
                                    </td>


                                    <!-- Contact -->
                                    <td>
                                        <div><%= hotel.phone %></div>
                                        <small class="text-muted">
                                            <%= hotel.email %>
                                        </small>
                                    </td>


                                    <!-- Check In -->
                                    <td>
                                        <%= hotel.checkInTime %>
                                    </td>


                                    <!-- Check Out -->
                                    <td>
                                        <%= hotel.checkOutTime %>
                                    </td>


                                    <!-- Status -->
                                    <td>
                                        <% if (hotel.status === "Active") { %>

                                            <span class="badge bg-success-subtle text-success">
                                                Active
                                            </span>

                                        <% } else { %>

                                            <span class="badge bg-danger-subtle text-danger">
                                                Inactive
                                            </span>

                                        <% } %>
                                    </td>


                                    <!-- Actions -->
                                    <td class="text-end pe-4">

                                        <a
                                            href="/api/admin/hotel/edit/<%= hotel._id %>"
                                            class="btn btn-sm btn-outline-primary"
                                        >
                                            <i class="bi bi-pencil"></i>
                                        </a>

                                        <form
                                            action="/api/admin/hotel/<%= hotel._id %>"
                                            method="POST"
                                            class="d-inline"
                                        >
                                            <button
                                                type="submit"
                                                class="btn btn-sm btn-outline-danger"
                                                onclick="return confirm('Delete this hotel?')"
                                            >
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </form>

                                    </td>

                                </tr>

                            <% }) %>
                        </tbody>

                    </table>
                </div>

            <% } else { %>

                <div class="text-center py-5">

                    <i class="bi bi-building fs-1 text-muted"></i>

                    <h5 class="mt-3">
                        No hotels found
                    </h5>

                    <p class="text-muted">
                        Start by adding your first hotel.
                    </p>

                    <a href="/api/admin/hotel/add" class="btn btn-dark">
                        Add Hotel
                    </a>

                </div>

            <% } %>

        </div>
    </div>

</div>
