<div class="container-fluid p-4">

    <div class="mb-4">
        <h3 class="mb-1">Add Room</h3>
        <small class="text-muted">Add a new room</small>
    </div>

    <div class="card shadow-sm">
        <div class="card-body">

            <form
                action="/api/admin/rooms/add"
                method="POST"
                enctype="multipart/form-data">

                <div class="row g-3">

                    <!-- Hotel ID
                    <div class="col-md-6">
                        <label class="form-label">Hotel ID</label>
                        <input
                            type="text"
                            name="hotelId"
                            class="form-control"
                            required>
                    </div> -->

                    <!-- Room Number -->
                    <div class="col-md-3">
                        <label class="form-label">Room Number</label>
                        <input
                            type="text"
                            name="roomNumber"
                            class="form-control"
                            required>
                    </div>

                    <!-- Room Type -->
                    <div class="col-md-3">
                        <label class="form-label">Room Type</label>

                        <select name="roomType" class="form-select" required>
                            <option value="">Select</option>
                            <option value="Single">Single</option>
                            <option value="Double">Double</option>
                            <option value="Twin">Twin</option>
                            <option value="Deluxe">Deluxe</option>
                            <option value="Suite">Suite</option>
                            <option value="Family">Family</option>
                            <option value="Executive">Executive</option>
                        </select>

                    </div>


                    <!-- Floor -->
                    <div class="col-md-3">
                        <label class="form-label">Floor</label>
                        <input
                            type="number"
                            name="floor"
                            class="form-control"
                            required>
                    </div>


                    <!-- Max Guests -->
                    <div class="col-md-3">
                        <label class="form-label">Max Guests</label>
                        <input
                            type="number"
                            name="maxGuests"
                            min="1"
                            class="form-control"
                            required>
                    </div>


                    <!-- Bed Type -->
                    <div class="col-md-3">
                        <label class="form-label">Bed Type</label>

                        <select name="bedType" class="form-select" required>
                            <option value="">Select</option>
                            <option value="Single">Single</option>
                            <option value="Double">Double</option>
                            <option value="Queen">Queen</option>
                            <option value="King">King</option>
                            <option value="Twin">Twin</option>
                        </select>

                    </div>


                    <!-- Bed Count -->
                    <div class="col-md-3">
                        <label class="form-label">Bed Count</label>
                        <input
                            type="number"
                            name="bedCount"
                            min="1"
                            value="1"
                            class="form-control">
                    </div>


                    <!-- Price -->
                    <div class="col-md-4">
                        <label class="form-label">Price / Night</label>
                        <input
                            type="number"
                            name="pricePerNight"
                            min="0"
                            class="form-control"
                            required>
                    </div>


                    <!-- Size -->
                    <div class="col-md-4">
                        <label class="form-label">Size (sq ft)</label>
                        <input
                            type="number"
                            name="size"
                            min="0"
                            class="form-control">
                    </div>


                    <!-- Status -->
                    <div class="col-md-4">
                        <label class="form-label">Status</label>

                        <select name="status" class="form-select">
                            <option value="Available">Available</option>
                            <option value="Booked">Booked</option>
                            <option value="Maintenance">Maintenance</option>
                            <option value="Cleaning">Cleaning</option>
                        </select>

                    </div>


                    <!-- Amenities -->
                    <div class="col-md-6">
                        <label class="form-label">Amenities</label>

                        <input
                            type="text"
                            name="amenities"
                            class="form-control"
                            placeholder="WiFi, TV, Mini Bar">
                    </div>


                    <!-- Image -->
                    <div class="col-md-6">
                        <label class="form-label">Room Image</label>

                        <input
                            type="file"
                            name="image"
                            class="form-control"
                            accept="image/*">
                    </div>


                    <!-- Description -->
                    <div class="col-12">
                        <label class="form-label">Description</label>

                        <textarea
                            name="description"
                            class="form-control"
                            rows="3"
                            placeholder="Room description"></textarea>
                    </div>


                    <!-- Features -->
                    <div class="col-12">

                        <label class="form-label">Features</label>

                        <div class="d-flex gap-4">

                            <div class="form-check">
                                <input
                                    type="checkbox"
                                    name="hasAC"
                                    value="true"
                                    class="form-check-input"
                                    checked>

                                <label class="form-check-label">
                                    AC
                                </label>
                            </div>


                            <div class="form-check">
                                <input
                                    type="checkbox"
                                    name="hasBalcony"
                                    value="true"
                                    class="form-check-input">

                                <label class="form-check-label">
                                    Balcony
                                </label>
                            </div>


                            <div class="form-check">
                                <input
                                    type="checkbox"
                                    name="isSmokingAllowed"
                                    value="true"
                                    class="form-check-input">

                                <label class="form-check-label">
                                    Smoking Allowed
                                </label>
                            </div>

                        </div>

                    </div>

                </div>


                <!-- Buttons -->
                <div class="mt-4">

                    <a
                        href="/api/admin/rooms"
                        class="btn btn-secondary">
                        Cancel
                    </a>

                    <button
                        type="submit"
                        class="btn btn-primary">
                        Add Room
                    </button>

                </div>

            </form>

        </div>
    </div>

</div>
