<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Booking Details</h2>
            <p class="text-muted mb-0">View and manage guest booking</p>
        </div>
        <a href="/api/admin/booking" class="btn btn-outline-secondary">
            ← Back to Bookings
        </a>
    </div>

    <div class="row g-4">
        <!-- Booking Information -->
        <div class="col-lg-8">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white py-3">
                    <div class="d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">Booking Information</h5>

                        <% if (booking.status === "Confirmed") { %>
                            <span class="badge bg-success">Confirmed</span>
                        <% } else if (booking.status === "Pending") { %>
                            <span class="badge bg-warning text-dark">Pending</span>
                        <% } else if (booking.status === "Cancelled") { %>
                            <span class="badge bg-danger">Cancelled</span>
                        <% } else { %>
                            <span class="badge bg-secondary"><%= booking.status %></span>
                        <% } %>
                    </div>
                </div>

                <div class="card-body">
                    <div class="row g-4">
                        <div class="col-md-6">
                            <small class="text-muted">Booking ID</small>
                            <p class="fw-semibold text-break"><%= booking._id %></p>
                        </div>

                        <div class="col-md-6">
                            <small class="text-muted">User ID</small>
                            <p class="fw-semibold text-break"><%= booking.userId %></p>
                        </div>

                        <div class="col-md-6">
                            <small class="text-muted">Room ID</small>
                            <p class="fw-semibold text-break"><%= booking.roomId %></p>
                        </div>

                        <div class="col-md-6">
                            <small class="text-muted">Guests</small>
                            <p class="fw-semibold">👤 <%= booking.guests %></p>
                        </div>

                        <div class="col-md-6">
                            <small class="text-muted">Check-In</small>
                            <p class="fw-semibold">
                                📅 <%= new Date(booking.checkIn).toLocaleDateString("en-IN") %>
                            </p>
                        </div>

                        <div class="col-md-6">
                            <small class="text-muted">Check-Out</small>
                            <p class="fw-semibold">
                                📅 <%= new Date(booking.checkOut).toLocaleDateString("en-IN") %>
                            </p>
                        </div>

                        <div class="col-md-6">
                            <small class="text-muted">Price Per Night</small>
                            <p class="fw-semibold">₹<%= booking.pricePerNight %></p>
                        </div>

                        <div class="col-md-6">
                            <small class="text-muted">Total Amount</small>
                            <p class="fw-bold fs-5">₹<%= booking.totalAmount %></p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Update Status -->
        <div class="col-lg-4">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white py-3">
                    <h5 class="mb-0">Update Booking</h5>
                </div>

                <div class="card-body">
                    <form action="/api/admin/booking/<%= booking._id %>/status" method="POST">
                        <div class="mb-3">
                            <label class="form-label fw-semibold">Booking Status</label>

                            <select name="status" class="form-select" required>
                                <option value="Pending" <%= booking.status === "Pending" ? "selected" : "" %>>
                                    Pending
                                </option>
                                <option value="Confirmed" <%= booking.status === "Confirmed" ? "selected" : "" %>>
                                    Confirmed
                                </option>
                                <option value="Cancelled" <%= booking.status === "Cancelled" ? "selected" : "" %>>
                                    Cancelled
                                </option>
                                <option value="Completed" <%= booking.status === "Completed" ? "selected" : "" %>>
                                    Completed
                                </option>
                            </select>
                        </div>

                        <button type="submit" class="btn btn-primary w-100">
                            Update Status
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>