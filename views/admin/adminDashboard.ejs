<div class="container-fluid py-4">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Admin Dashboard</h2>
            <p class="text-muted mb-0">
                Welcome back, <%= admin?.name || "Admin" %>. Here's what's happening today.
            </p>
        </div>

        <span class="badge bg-dark px-3 py-2">
            <i class="bi bi-calendar3"></i>
            <%= new Date().toLocaleDateString("en-IN", {
                day: "2-digit", month: "short", year: "numeric"
            }) %>
        </span>
    </div>


    <!-- Statistics -->
    <div class="row g-4 mb-4">

        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <p class="text-muted mb-2">Total Users</p>
                        <h3 class="fw-bold mb-0"><%= totalUsers || 0 %></h3>
                    </div>
                    <div class="bg-primary bg-opacity-10 rounded-circle p-3">
                        <i class="bi bi-people fs-4 text-primary"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <p class="text-muted mb-2">Total Rooms</p>
                        <h3 class="fw-bold mb-0"><%= totalRooms || 0 %></h3>
                    </div>
                    <div class="bg-success bg-opacity-10 rounded-circle p-3">
                        <i class="bi bi-door-open fs-4 text-success"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <p class="text-muted mb-2">Total Bookings</p>
                        <h3 class="fw-bold mb-0"><%= totalBookings || 0 %></h3>
                    </div>
                    <div class="bg-warning bg-opacity-10 rounded-circle p-3">
                        <i class="bi bi-calendar-check fs-4 text-warning"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <p class="text-muted mb-2">Total Revenue</p>
                        <h3 class="fw-bold mb-0">₹<%= totalRevenue || 0 %></h3>
                    </div>
                    <div class="bg-info bg-opacity-10 rounded-circle p-3">
                        <i class="bi bi-currency-rupee fs-4 text-info"></i>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body d-flex justify-content-between align-items-center">
                    <div>
                        <p class="text-muted mb-2">Total Hotels</p>
                        <h3 class="fw-bold mb-0"><%= hotelListedCount || 0 %></h3>
                    </div>
                    <div class="bg-info bg-opacity-10 rounded-circle p-3">
                        <i class="bi bi-currency-rupee fs-4 text-info"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>


    <!-- Main Content -->
    <div class="row g-4">

        <!-- Recent Bookings -->
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm">

                <div class="card-header bg-white border-0 p-4 d-flex justify-content-between align-items-center">
                    <div>
                        <h5 class="fw-bold mb-1">Recent Bookings</h5>
                        <p class="text-muted small mb-0">Latest hotel reservations</p>
                    </div>
                    <a href="/api/admin/booking" class="btn btn-sm btn-outline-dark">
                        View All
                    </a>
                </div>

                <div class="card-body p-0">

                    <% if (recentBookings?.length) { %>

                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th class="ps-4">Guest</th>
                                        <th>Room</th>
                                        <th>Check In</th>
                                        <th>Check Out</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>

                                <tbody>
                                    <% recentBookings.forEach(booking => { %>
                                        <tr>
                                            <td class="ps-4">
                                                <div class="fw-semibold">
                                                    <%= booking.userId?.name || "Guest" %>
                                                </div>
                                                <small class="text-muted">
                                                    <%= booking.userId?.email || "" %>
                                                </small>
                                            </td>

                                            <td>Room <%= booking.roomId?.roomNumber || "N/A" %></td>

                                            <td>
                                                <%= booking.checkIn
                                                    ? new Date(booking.checkIn).toLocaleDateString("en-IN")
                                                    : "N/A" %>
                                            </td>

                                            <td>
                                                <%= booking.checkOut
                                                    ? new Date(booking.checkOut).toLocaleDateString("en-IN")
                                                    : "N/A" %>
                                            </td>

                                            <td>
                                                <% if (booking.status === "Confirmed") { %>
                                                    <span class="badge bg-success-subtle text-success">Confirmed</span>
                                                <% } else if (booking.status === "Pending") { %>
                                                    <span class="badge bg-warning-subtle text-warning">Pending</span>
                                                <% } else if (booking.status === "Cancelled") { %>
                                                    <span class="badge bg-danger-subtle text-danger">Cancelled</span>
                                                <% } else { %>
                                                    <span class="badge bg-secondary-subtle text-secondary">
                                                        <%= booking.status %>
                                                    </span>
                                                <% } %>
                                            </td>
                                        </tr>
                                    <% }) %>
                                </tbody>
                            </table>
                        </div>

                    <% } else { %>

                        <div class="text-center py-5">
                            <i class="bi bi-calendar-x fs-1 text-muted"></i>
                            <h6 class="mt-3">No bookings found</h6>
                            <p class="text-muted small mb-0">
                                There are no recent bookings to display.
                            </p>
                        </div>

                    <% } %>

                </div>
            </div>
        </div>


        <!-- Right Side -->
        <div class="col-lg-4">

            <!-- Quick Actions -->
            <div class="card border-0 shadow-sm">
                <div class="card-header bg-white border-0 p-4">
                    <h5 class="fw-bold mb-1">Quick Actions</h5>
                    <p class="text-muted small mb-0">Manage your hotel easily</p>
                </div>

                <div class="card-body">
                    <div class="d-grid gap-3">

                        <a href="/api/admin/rooms/add" class="btn btn-dark text-start p-3">
                            <i class="bi bi-plus-circle me-2"></i> Add New Room
                        </a>

                        <a href="/api/admin/rooms" class="btn btn-outline-dark text-start p-3">
                            <i class="bi bi-door-open me-2"></i> Manage Rooms
                        </a>

                        <a href="/api/admin/booking" class="btn btn-outline-dark text-start p-3">
                            <i class="bi bi-calendar-check me-2"></i> Manage Bookings
                        </a>

                    </div>
                </div>
            </div>


            <!-- Booking Summary -->
            <div class="card border-0 shadow-sm mt-4">
                <div class="card-body p-4">

                    <h6 class="fw-bold mb-4">Booking Summary</h6>

                    <div class="d-flex justify-content-between mb-3">
                        <span class="text-muted">Confirmed</span>
                        <strong><%= confirmedBookings || 0 %></strong>
                    </div>

                    <div class="d-flex justify-content-between mb-3">
                        <span class="text-muted">Pending</span>
                        <strong><%= pendingBookings || 0 %></strong>
                    </div>

                    <div class="d-flex justify-content-between">
                        <span class="text-muted">Cancelled</span>
                        <strong><%= cancelledBookings || 0 %></strong>
                    </div>

                </div>
            </div>

        </div>

    </div>

</div>
