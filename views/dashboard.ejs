<!-- Welcome Banner -->

<div class="card shadow border-0 mb-4"
     style="background:linear-gradient(135deg,#667eea,#764ba2);color:white;">

    <div class="card-body p-5">

        <div class="row align-items-center">

            <div class="col-md-8">

                <h1>
                    Welcome back, <%= user?.name || "Traveler" %> ✈️
                </h1>

                <p class="mt-3 fs-5">
                    Plan your next stay and explore amazing destinations.
                </p>

                <a href="/api/hotel"
                   class="btn btn-light mt-3 px-4">
                    Explore Hotels
                </a>

            </div>

            <div class="col-md-4 text-center">

                <img src="/images/banner/hotel banner image.webp"
                     class="img-fluid"
                     style="max-height:180px;width:100%;"
                     alt="Hotel">

            </div>

        </div>

    </div>

</div>


<!-- Statistics -->

<div class="row g-4 mb-4">

    <!-- Total Trips -->

    <div class="col-md-3">

        <div class="card shadow border-0 h-100">

            <div class="card-body">

                <div class="d-flex justify-content-between">

                    <div>

                        <p class="text-muted mb-1">
                            Total Trips
                        </p>

                        <h2>
                            <%= totalTrips || 0 %>
                        </h2>

                    </div>

                    <div class="fs-1">
                        🏨
                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- Upcoming Bookings -->

    <div class="col-md-3">

        <div class="card shadow border-0 h-100">

            <div class="card-body">

                <div class="d-flex justify-content-between">

                    <div>

                        <p class="text-muted mb-1">
                            Upcoming
                        </p>

                        <h2>
                            <%= upcomingCount || 0 %>
                        </h2>

                    </div>

                    <div class="fs-1">
                        🗓️
                    </div>

                </div>

            </div>

        </div>

    </div>

</div>


<!-- Current / Upcoming Booking -->

<% if (upcomingBooking) { %>

    <div class="card shadow border-0 mb-5">

        <div class="card-body">

            <div class="row align-items-center">

                <!-- Hotel Image -->

                <div class="col-md-4">

                    <% if (upcomingBooking.roomId?.hotelId?.hotelImage) { %>

                        <img
                            src="/uploads/<%= upcomingBooking.roomId.hotelId.hotelImage %>"
                            class="img-fluid rounded"
                            style="height:200px;width:100%;object-fit:cover;"
                            alt="Hotel Image">

                    <% } else { %>

                        <div class="bg-light rounded d-flex align-items-center justify-content-center"
                             style="height:200px;width:100%;">

                            <span class="text-muted">
                                No Hotel Image
                            </span>

                        </div>

                    <% } %>

                </div>


                <!-- Booking Information -->

                <div class="col-md-5">

                    <h3>
                        <%= upcomingBooking.roomId?.hotelId?.name || "Hotel" %>
                    </h3>

                    <p class="text-muted">

                        📍
                        <%= upcomingBooking.roomId?.hotelId?.city || "India" %>

                    </p>

                    <p>

                        🛏
                        <%= upcomingBooking.roomId?.roomType || "Room" %>
                        Room

                    </p>

                    <p>

                        📅

                        <%= new Date(upcomingBooking.checkIn)
                            .toLocaleDateString("en-IN") %>

                        -

                        <%= new Date(upcomingBooking.checkOut)
                            .toLocaleDateString("en-IN") %>

                    </p>

                    <span class="badge bg-success">

                        <%= upcomingBooking.status %>

                    </span>

                </div>


                <!-- View Booking -->

                <div class="col-md-3 text-center">

                    <a href="/api/booking/details/<%= upcomingBooking._id %>"
                       class="btn btn-primary px-4">

                        View Booking

                    </a>

                </div>

            </div>

        </div>

    </div>


<% } else { %>


    <!-- No Upcoming Booking -->

    <div class="card shadow border-0 mb-5">

        <div class="card-body text-center py-4">

            <h4>
                No Upcoming Stay 🏝️
            </h4>

            <p class="text-muted">

                You don't have any upcoming bookings.

            </p>

            <a href="/api/hotel"
               class="btn btn-primary">

                Browse Hotels

            </a>

        </div>

    </div>


<% } %>
