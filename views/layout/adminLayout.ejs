        href="/css/admin.css"
    >

</head>


<body>


    <!-- ========================= -->
    <!-- ADMIN NAVBAR -->
    <!-- ========================= -->

    <nav class="navbar navbar-expand-lg navbar-light bg-white shadow-sm">

        <%- include('../partials/adminNavbar') %>

    </nav>


    <!-- ========================= -->
