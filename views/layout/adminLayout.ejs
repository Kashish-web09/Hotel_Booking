    <!-- ========================= -->

    <main>

        <%- body %>

    </main>

<footer>
    <%- include('../partials/footer') %>
</footer>
    <!-- ========================= -->
    <!-- BOOTSTRAP JS -->
    <!-- ========================= -->


    <script
        src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"
    ></script>


</body>

</html>
