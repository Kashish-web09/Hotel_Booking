<div class="container-fluid min-vh-100 d-flex align-items-center justify-content-center bg-light">


    <div class="row shadow-lg rounded-4 overflow-hidden bg-white"
         style="max-width:1100px; width:100%;">



        <!-- Left Hotel Branding -->

        <div class="col-lg-5 d-none d-lg-flex align-items-center justify-content-center bg-dark text-white p-5">


            <div class="text-center">


                <i class="bi bi-building fs-1 text-warning"></i>


                <h1 class="fw-bold mt-3">
                    Luxury Stay
                </h1>


                <p class="text-white-50">
                    Your comfort, our priority.
                    Experience premium rooms,
                    exclusive services and unforgettable stays.
                </p>


                <hr class="border-light">


                <div class="mt-4">


                    <p>
                        <i class="bi bi-house-door text-warning"></i>
                        Premium Rooms
                    </p>


                    <p>
                        <i class="bi bi-calendar-check text-warning"></i>
                        Easy Reservations
                    </p>


                    <p>
                        <i class="bi bi-shield-check text-warning"></i>
                        Secure Booking
                    </p>


                </div>


            </div>


        </div>






        <!-- Login Form -->

        <div class="col-lg-7 p-5">


            <div class="text-center mb-4">


                <i class="bi bi-person-circle fs-1 text-warning"></i>


                <h2 class="fw-bold mt-3">
                    Welcome Back
                </h2>


                <p class="text-muted">
                    Login to manage your bookings and enjoy exclusive offers.
                </p>


            </div>





            <form action="/api/auth/login" method="POST">





                <!-- Email -->


                <div class="mb-4">


                    <label class="form-label fw-semibold">
                        Email Address
                    </label>


                    <input
                        type="email"
                        class="form-control form-control-lg rounded-3"
                        name="email"
                        placeholder="Enter your email"
                        value="<%= oldData.email || '' %>"
                    >



                    <% if(errors){ %>

                        <% errors.forEach(error=>{ %>

                            <% if(error.path==="email"){ %>

                                <small class="text-danger">
                                    <%= error.msg %>
                                </small>

                            <% } %>

                        <% }) %>

                    <% } %>



                </div>







                <!-- Password -->


                <div class="mb-4">


                    <label class="form-label fw-semibold">
                        Password
                    </label>


                    <input
                        type="password"
                        class="form-control form-control-lg rounded-3"
                        name="password"
                        placeholder="Enter your password"
                    >



                    <% if(errors){ %>

                        <% errors.forEach(error=>{ %>

                            <% if(error.path==="password"){ %>

                                <small class="text-danger">
                                    <%= error.msg %>
                                </small>

                            <% } %>

                        <% }) %>

                    <% } %>



                </div>







                <!-- Remember / Forgot -->


                <div class="d-flex justify-content-between align-items-center mb-4">


                    <div class="form-check">


                        <input
                            class="form-check-input"
                            type="checkbox"
                            id="remember"
                        >


                        <label class="form-check-label" for="remember">

                            Remember Me

                        </label>


                    </div>




                    <a href="/api/auth/forgot-pass"
                       class="text-warning fw-semibold text-decoration-none">

                        Forgot Password?

                    </a>



                </div>







                <!-- Button -->


                <div class="d-grid">


                    <button 
                        class="btn btn-warning rounded-pill py-2 fw-bold">


                        <i class="bi bi-box-arrow-in-right"></i>

                        Login


                    </button>


                </div>






            </form>





            <hr class="my-4">





            <p class="text-center mb-0">


                Don't have an account?


                <a 
                    href="/api/auth/register"
                    class="text-warning fw-bold text-decoration-none">


                    Create Account


                </a>


            </p>



        </div>




    </div>


</div>