<!-- Navbar -->
<nav class="navbar navbar-expand-lg bg-white shadow-sm py-2">
    <div class="container">

        <!-- Logo -->
        <a class="navbar-brand fw-bold text-primary d-flex align-items-center gap-2" href="/">
            <i class="bi bi-building fs-4"></i>
            <span>Hotel BradMate</span>
        </a>

        <!-- Mobile Toggle -->
        <button
            class="navbar-toggler"
            type="button"
            data-bs-toggle="collapse"
            data-bs-target="#navbar"
            aria-controls="navbar"
            aria-expanded="false"
            aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>

        <!-- Navbar Content -->
        <div class="collapse navbar-collapse" id="navbar">

            <!-- Left Menu -->
            <ul class="navbar-nav mx-auto gap-lg-2">

                <li class="nav-item">
                    <a class="nav-link px-3" href="/">
                        <i class="bi bi-house-door me-1"></i>
                        Home
                    </a>
                </li>
                <li class="nav-item">
                    <a class="nav-link px-3" href="/api/hotel">
                        <i class="bi bi-building me-1"></i>
                        Hotels
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link px-3" href="/api/rooms">
                        <i class="bi bi-door-open me-1"></i>
                        Rooms
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link px-3" href="/about-us">
                        <i class="bi bi-info-circle me-1"></i>
                        About
                    </a>
                </li>

                <li class="nav-item">
                    <a class="nav-link px-3" href="/api/feedback">
                        <i class="bi bi-envelope me-1"></i>
                        Contact
                    </a>
                </li>

                <% if (isLogin) { %>
                    <li class="nav-item">
                        <a class="nav-link px-3" href="/api/booking">
                            <i class="bi bi-calendar-check me-1"></i>
                            My Bookings
                        </a>
                    </li>
                <% } %>

            </ul>

            <!-- Right Side -->
            <ul class="navbar-nav align-items-lg-center gap-2">

                <% if (isLogin) { %>

                    <!-- Profile -->
                    <li class="nav-item">
                        <a
                            href="/api/auth/profile"
                            class="d-flex align-items-center text-decoration-none px-2 py-1 rounded-pill profile-link">

                            <% if (user?.image) { %>
                                <img
                                    src="/uploads/<%= user.image %>"
                                    alt="Profile"
                                    class="rounded-circle border"
                                    width="38"
                                    height="38"
                                    style="object-fit: cover;">
                            <% } else { %>
                                <span
                                    class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center"
                                    style="width:38px;height:38px;">
                                    <i class="bi bi-person-fill"></i>
                                </span>
                            <% } %>

                            <span class="ms-2 fw-semibold text-dark">
                                <%= user?.name || "User" %>
                            </span>
                        </a>
                    </li>

                    <!-- Logout -->
                    <li class="nav-item">
                        <a
                            href="/api/auth/logout"
                            class="btn btn-outline-danger btn-sm px-3">
                            <i class="bi bi-box-arrow-right me-1"></i>
                            Logout
                        </a>
                    </li>

                <% } else { %>

                    <!-- Login -->
                    <li class="nav-item">
                        <a
                            href="/api/auth/login"
                            class="btn btn-primary btn-sm px-4">
                            <i class="bi bi-box-arrow-in-right me-1"></i>
                            Login
                        </a>
                    </li>

                <% } %>

            </ul>

        </div>
    </div>
</nav>

<style>
    .navbar {
        min-height: 70px;
    }

    .navbar-brand {
        font-size: 1.25rem;
        letter-spacing: -0.3px;
    }

    .nav-link {
        color: #555 !important;
        font-weight: 500;
        transition: 0.2s ease;
    }

    .nav-link:hover {
        color: #0d6efd !important;
    }

    .profile-link {
        transition: 0.2s ease;
    }

    .profile-link:hover {
        background-color: #f5f7fa;
    }

    .profile-link img {
        border-color: #dee2e6 !important;
    }

    @media (max-width: 991px) {
        .navbar-nav {
            padding-top: 10px;
        }

        .navbar-nav .nav-link {
            padding: 10px 5px;
        }

        .profile-link {
            margin-top: 8px;
        }
    }
</style>