<%
    const adminUser = typeof admin !== "undefined" ? admin : null;
%>

<!-- Admin Navbar -->
<nav class="navbar navbar-expand-lg bg-white shadow-sm py-2">
    <div class="container-fluid px-lg-4">
        <!-- Brand -->
        <a
            class="navbar-brand fw-bold text-primary d-flex align-items-center gap-2"
            href="<%= isLogin ? '/dashboard/admin' : '/api/admin/login' %>">
            <i class="bi bi-building fs-4"></i>
            <span>Hotel Admin</span>
        </a>

        <!-- Mobile Toggle -->
        <button
            class="navbar-toggler"
            type="button"
            data-bs-toggle="collapse"
            data-bs-target="#adminNavbar"
            aria-controls="adminNavbar"
            aria-expanded="false"
            aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>

        <!-- Navbar Content -->
        <div class="collapse navbar-collapse" id="adminNavbar">
            <% if (isLogin) { %>

                <!-- Left Menu -->
                <ul class="navbar-nav mx-auto gap-lg-2">
                    <li class="nav-item">
                        <a class="nav-link px-3" href="/dashboard/admin">
                            <i class="bi bi-speedometer2 me-1"></i>
                            Dashboard
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link px-3" href="/api/hotel">
                            <i class="bi bi-building me-1"></i>
                            Hotels
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link px-3" href="/api/rooms">
                            <i class="bi bi-door-open me-1"></i>
                            Rooms
                        </a>
                    </li>
 <li class="nav-item">
                     

                     <li class="nav-item">
                        <a class="nav-link px-3" href="/api/payment/admin">
<i class="bi bi-credit-card me-1"></i>
                            Payment History
                        </a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link px-3" href="/api/booking">
                            <i class="bi bi-calendar-check me-1"></i>
                            Bookings
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link px-3" href="/api/travel">
                            <i class="bi bi-geo-alt me-1"></i>
                            Destination
                        </a>
                    </li>

                    <li class="nav-item">
                        <a class="nav-link px-3" href="/api/feedback">
                            <i class="bi bi-chat-left-text me-1"></i>
                            Feedback
                        </a>
                    </li>
                </ul>

                <!-- Right Side -->
                <div class="d-flex align-items-center">
                    <div class="dropdown">
                        <button
                            class="btn profile-btn d-flex align-items-center gap-2 px-2 py-1"
                            type="button"
                            data-bs-toggle="dropdown"
                            aria-expanded="false">

                            <% if (adminUser?.image) { %>
                                <img
                                    src="/uploads/<%= adminUser.image %>"
                                    alt="Admin"
                                    class="rounded-circle border"
                                    width="40"
                                    height="40"
                                    style="object-fit: cover;">
                            <% } else { %>
                                <span
                                    class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center"
                                    style="width:40px;height:40px;">
                                    <i class="bi bi-person-fill"></i>
                                </span>
                            <% } %>

                            <span class="d-none d-md-inline fw-semibold text-dark">
                                <%= adminUser?.name || "Admin" %>
                            </span>

                            <i class="bi bi-chevron-down small text-muted"></i>
                        </button>

                        <!-- Dropdown -->
                        <ul class="dropdown-menu dropdown-menu-end shadow border-0 mt-2">
                            <li>
                                <div class="dropdown-header py-3">
                                    <div class="d-flex align-items-center gap-3">
                                        <% if (adminUser?.image) { %>
                                            <img
                                                src="/uploads/<%= adminUser.image %>"
                                                alt="Admin"
                                                class="rounded-circle"
                                                width="45"
                                                height="45"
                                                style="object-fit: cover;">
                                        <% } else { %>
                                            <span
                                                class="rounded-circle bg-primary text-white d-flex align-items-center justify-content-center"
                                                style="width:45px;height:45px;">
                                                <i class="bi bi-person-fill"></i>
                                            </span>
                                        <% } %>

                                        <div>
                                            <div class="fw-semibold text-dark">
                                                <%= adminUser?.name || "Admin" %>
                                            </div>
                                            <small class="text-muted">
                                                Administrator
                                            </small>
                                        </div>
                                    </div>
                                </div>
                            </li>

                            <li><hr class="dropdown-divider"></li>

                            <li>
                                <a class="dropdown-item py-2" href="/api/auth/profile">
                                    <i class="bi bi-person me-2"></i>
                                    Profile
                                </a>
                            </li>

                            <li>
                                <a class="dropdown-item py-2" href="/api/dashboard">
                                    <i class="bi bi-speedometer2 me-2"></i>
                                    Dashboard
                                </a>
                            </li>

                            <li><hr class="dropdown-divider"></li>

                            <li>
                                <a
                                    class="dropdown-item text-danger py-2"
                                    href="/api/auth/logout">
                                    <i class="bi bi-box-arrow-right me-2"></i>
                                    Logout
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>

            <% } else { %>

                <!-- Not Logged In -->
                <div class="ms-auto">
                    <a
                        href="/api/admin/login"
                        class="btn btn-primary px-4 d-flex align-items-center gap-2">
                        <i class="bi bi-box-arrow-in-right"></i>
                        Login
                    </a>
                </div>

            <% } %>
        </div>
    </div>
</nav>

<!-- Navbar CSS -->
<style>
    .navbar {
        min-height: 70px;
    }

    .navbar-brand {
        font-size: 1.25rem;
        letter-spacing: -0.3px;
    }

    .nav-link {
        color: #555 !important;
        font-weight: 500;
        transition: all 0.2s ease;
    }

    .nav-link:hover {
        color: #0d6efd !important;
    }

    .profile-btn {
        border: none;
        background: transparent;
        transition: 0.2s ease;
    }

    .profile-btn:hover {
        background-color: #f5f7fa;
    }

    .profile-btn:focus {
        box-shadow: none;
    }

    .dropdown-menu {
        min-width: 240px;
        border-radius: 10px;
    }

    .dropdown-item {
        border-radius: 6px;
        margin: 2px 5px;
        width: calc(100% - 10px);
        transition: 0.2s ease;
    }

    .dropdown-item:hover {
        background-color: #f5f7fa;
    }

    @media (max-width: 991px) {
        .navbar-nav {
            padding-top: 10px;
        }

        .navbar-nav .nav-link {
            padding: 10px 5px;
        }

        .profile-btn {
            margin-top: 10px;
        }
    }
</style>