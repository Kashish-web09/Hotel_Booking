<div class="container py-5">

    <div class="row g-5">

        <!-- Hotel Image -->
        <div class="col-lg-7">

            <% if (hotel.hotelImage) { %>

                <img
                    src="/uploads/<%= hotel.hotelImage %>"
                    alt="<%= hotel.name %>"
                    class="img-fluid rounded-4 w-100 hotel-main-image"
                >

            <% } else { %>

                <div class="no-image rounded-4 d-flex align-items-center justify-content-center">
                    <span>No Image Available</span>
                </div>

            <% } %>

        </div>


        <!-- Hotel Information -->
        <div class="col-lg-5">

            <span class="badge bg-primary mb-3">
                Hotel
            </span>

            <!-- Hotel Name -->
            <h1 class="fw-bold mb-3">
                <%= hotel.name %>
            </h1>


            <!-- Address -->
            <p class="text-muted mb-3">

                <i class="bi bi-geo-alt-fill text-danger me-2"></i>

                <%= hotel.address %>,
                <%= hotel.city %>,
                <%= hotel.state %>,
                <%= hotel.country %>
                - <%= hotel.pincode %>

            </p>


            <!-- Description -->
            <% if (hotel.desc) { %>

                <div class="mt-4">

                    <h4 class="fw-semibold mb-2">
                        About the Hotel
                    </h4>

                    <p class="text-secondary lh-lg">
                        <%= hotel.desc %>
                    </p>

                </div>

            <% } %>


            <!-- Hotel Details -->
            <div class="mt-4">

                <h4 class="fw-semibold mb-3">
                    Hotel Details
                </h4>

                <div class="row g-3">

                    <!-- Check In -->
                    <div class="col-6">

                        <div class="border rounded-3 p-3">

                            <small class="text-muted d-block mb-1">
                                Check-in
                            </small>

                            <strong>
                                <i class="bi bi-clock me-1"></i>
                                <%= hotel.checkInTime %>
                            </strong>

                        </div>

                    </div>


                    <!-- Check Out -->
                    <div class="col-6">

                        <div class="border rounded-3 p-3">

                            <small class="text-muted d-block mb-1">
                                Check-out
                            </small>

                            <strong>
                                <i class="bi bi-clock me-1"></i>
                                <%= hotel.checkOutTime %>
                            </strong>

                        </div>

                    </div>


                    <!-- Phone -->
                    <div class="col-12">

                        <div class="border rounded-3 p-3">

                            <small class="text-muted d-block mb-1">
                                Contact
                            </small>

                            <strong>
                                <i class="bi bi-telephone me-1"></i>
                                <%= hotel.phone %>
                            </strong>

                        </div>

                    </div>


                    <!-- Email -->
                    <div class="col-12">

                        <div class="border rounded-3 p-3">

                            <small class="text-muted d-block mb-1">
                                Email
                            </small>

                            <strong>
                                <%= hotel.email %>
                            </strong>

                        </div>

                    </div>

                </div>

            </div>


            <!-- See Rooms -->
            <div class="mt-4">

                <a
                    href="/api/guest/rooms/hotel?hotelId=<%= hotel._id %>"
                    class="btn btn-primary btn-lg px-4"
                >

                    <i class="bi bi-door-open me-2"></i>

                    See Available Rooms

                </a>

            </div>

        </div>

    </div>

</div>


<style>

    .hotel-main-image {
        height: 450px;
        object-fit: cover;
    }

    .no-image {
        height: 450px;
        background: #f1f3f5;
        color: #6c757d;
    }

</style>

