<!-- Page Header -->
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">Find Your Hotel 🏨</h2>
        <p class="text-muted mb-0">
            Explore hotels and find the perfect stay.
        </p>
    </div>
</div>

<!-- Search -->
<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <form action="/api/guest/hotel/search" method="GET" class="row g-3">
            <div class="col-md-5">
                <label class="form-label">City</label>
                <input
                    type="text"
                    name="city"
                    class="form-control"
                    placeholder="Search by city"
                    value="<%= oldData?.city || '' %>"
                >
            </div>

            <div class="col-md-5">
                <label class="form-label">Hotel Name</label>
                <input
                    type="text"
                    name="name"
                    class="form-control"
                    placeholder="Search hotel"
                    value="<%= oldData?.name || '' %>"
                >
            </div>

            <div class="col-md-2 d-flex align-items-end">
                <button class="btn btn-primary w-100">
                    <i class="bi bi-search me-1"></i>
                    Search
                </button>
            </div>
        </form>
    </div>
</div>

<!-- Hotel List -->
<div class="d-flex justify-content-between align-items-center mb-3">
    <h4 class="fw-bold mb-0">Available Hotels</h4>
    <span class="text-muted">
        <%= hotels?.length || 0 %> Hotels
    </span>
</div>

<% if (hotels && hotels.length > 0) { %>

<div class="row g-4">
    <% hotels.forEach(hotel => { %>

    <div class="col-md-6 col-lg-4">
        <div class="card border-0 shadow-sm h-100">

            <img
                src="<%= hotel.hotelImage
                    ? '/uploads/' + hotel.hotelImage
                    : '/images/hotel1.jpg' %>"
                class="card-img-top"
                alt="<%= hotel.name %>"
                style="height:220px; object-fit:cover;"
            >

            <div class="card-body d-flex flex-column">

                <h5 class="fw-bold mb-1">
                    <%= hotel.name %>
                </h5>

                <p class="text-muted mb-2">
                    <i class="bi bi-geo-alt"></i>
                    <%= hotel.city %>, <%= hotel.state %>
                </p>

                <p class="text-muted small">
                    <%= hotel.desc?.length > 100
                        ? hotel.desc.substring(0, 100) + "..."
                        : hotel.desc %>
                </p>

                <p class="small mb-2">
                    <i class="bi bi-building"></i>
                    <%= hotel.address %>
                </p>

                <div class="small text-muted mb-3">
                    <div>
                        🕐 Check-in:
                        <strong><%= hotel.checkInTime %></strong>
                    </div>
                    <div>
                        🕐 Check-out:
                        <strong><%= hotel.checkOutTime %></strong>
                    </div>
                </div>

                <div class="mb-3">
                    <% if (hotel.status === "Active") { %>
                        <span class="badge bg-success">Available</span>
                    <% } else { %>
                        <span class="badge bg-secondary">
                            Currently Unavailable
                        </span>
                    <% } %>
                </div>

                <div class="mt-auto">
                    <a
                        href="/api/guest/hotel/<%= hotel._id %>"
                        class="btn btn-primary w-100"
                    >
                        View Hotel
                        <i class="bi bi-arrow-right ms-1"></i>
                    </a>
                </div>

            </div>
        </div>
    </div>

    <% }) %>
</div>

<% } else { %>

<!-- Empty State -->
<div class="card border-0 shadow-sm">
    <div class="card-body text-center py-5">
        <div class="fs-1 mb-3">🏨</div>

        <h4 class="fw-bold">No Hotels Found</h4>

        <p class="text-muted mb-3">
            We couldn't find any hotels matching your search.
        </p>

        <a
            href="/api/guest/hotel"
            class="btn btn-outline-primary"
        >
            View All Hotels
        </a>
    </div>
</div>

<% } %>