<div class="container py-5">

    <!-- Back -->
    <div class="mb-4">
        <a href="/api/hotel/rooms" class="text-decoration-none">
            ← Back to Rooms
        </a>
    </div>


    <% if (room) { %>

        <div class="row g-5">

            <!-- Room Images -->
            <div class="col-lg-7">

                <% if (room.images && room.images.length > 0) { %>

                    <!-- Main Image -->
                    <div class="card border-0 shadow-sm mb-3 overflow-hidden">
                        <img
                            id="mainRoomImage"
                            src="/uploads/<%= room.images[0] %>"
                            class="img-fluid w-100"
                            style="height: 450px; object-fit: cover;"
                            alt="<%= room.roomType %> Room">
                    </div>


                    <!-- Thumbnails -->
                    <% if (room.images.length > 1) { %>

                        <div class="d-flex gap-2 flex-wrap">

                            <% room.images.forEach((image, index) => { %>

                                <img
                                    src="/uploads/<%= image %>"
                                    class="rounded border"
                                    style="width: 90px; height: 70px; object-fit: cover; cursor: pointer;"
                                    onclick="changeRoomImage(this.src)"
                                    alt="Room image <%= index + 1 %>">

                            <% }) %>

                        </div>

                    <% } %>

                <% } else { %>

                    <div
                        class="bg-light rounded shadow-sm d-flex align-items-center justify-content-center"
                        style="height: 450px;">

                        <div class="text-center text-muted">
                            <div style="font-size: 50px;">🏨</div>
                            <p class="mb-0">No room image available</p>
                        </div>

                    </div>

                <% } %>

            </div>


            <!-- Room Information -->
            <div class="col-lg-5">

                <div class="d-flex justify-content-between align-items-start mb-2">

                    <div>
                        <h2 class="fw-bold mb-1">
                            <%= room.roomType %> Room
                        </h2>

                        <p class="text-muted mb-0">
                            Room <%= room.roomNumber %>
                        </p>
                    </div>


                    <% if (room.status === "Available") { %>

                        <span class="badge bg-success fs-6">
                            Available
                        </span>

                    <% } else if (room.status === "Booked") { %>

                        <span class="badge bg-danger fs-6">
                            Booked
                        </span>

                    <% } else if (room.status === "Maintenance") { %>

                        <span class="badge bg-warning text-dark fs-6">
                            Maintenance
                        </span>

                    <% } else { %>

                        <span class="badge bg-info fs-6">
                            <%= room.status %>
                        </span>

                    <% } %>

                </div>


                <!-- Price -->
                <div class="mb-4 mt-4">

                    <span class="fs-2 fw-bold">
                        ₹<%= room.pricePerNight %>
                    </span>

                    <span class="text-muted">
                        / night
                    </span>

                </div>


                <!-- Room Features -->
                <div class="card border-0 bg-light mb-4">

                    <div class="card-body">

                        <h5 class="mb-3">
                            Room Information
                        </h5>

                        <div class="row g-3">

                            <div class="col-6">
                                <div class="text-muted small">
                                    Room Type
                                </div>

                                <strong>
                                    <%= room.roomType %>
                                </strong>
                            </div>


                            <div class="col-6">
                                <div class="text-muted small">
                                    Room Number
                                </div>

                                <strong>
                                    <%= room.roomNumber %>
                                </strong>
                            </div>


                            <div class="col-6">
                                <div class="text-muted small">
                                    Floor
                                </div>

                                <strong>
                                    <%= room.floor %>
                                </strong>
                            </div>


                            <div class="col-6">
                                <div class="text-muted small">
                                    Maximum Guests
                                </div>

                                <strong>
                                    <%= room.maxGuests %>
                                </strong>
                            </div>

                        </div>

                    </div>

                </div>


                <!-- Description -->
                <div class="mb-4">

                    <h5>About this room</h5>

                    <p class="text-muted">
                        <%= room.description || "Comfortable room for your stay." %>
                    </p>

                </div>


                <!-- Booking -->
                <% if (room.status === "Available") { %>

                    <div class="card shadow-sm border-0">

                        <div class="card-body">

                            <h5 class="mb-3">
                                Book this room
                            </h5>

                            <form
                                action="/api/hotel/booking/create"
                                method="POST">

                                <input
                                    type="hidden"
                                    name="roomId"
                                    value="<%= room._id %>">


                                <div class="row g-3">

                                    <div class="col-md-6">

                                        <label class="form-label">
                                            Check In
                                        </label>

                                        <input
                                            type="date"
                                            name="checkIn"
                                            class="form-control"
                                            required>

                                    </div>


                                    <div class="col-md-6">

                                        <label class="form-label">
                                            Check Out
                                        </label>

                                        <input
                                            type="date"
                                            name="checkOut"
                                            class="form-control"
                                            required>

                                    </div>

                                </div>


                                <div class="mt-3">

                                    <label class="form-label">
                                        Guests
                                    </label>

                                    <input
                                        type="number"
                                        name="guests"
                                        min="1"
                                        max="<%= room.maxGuests %>"
                                        value="1"
                                        class="form-control"
                                        required>

                                </div>


                                <button
                                    type="submit"
                                    class="btn btn-primary w-100 mt-4">

                                    Book This Room

                                </button>

                            </form>

                        </div>

                    </div>

                <% } else { %>

                    <button
                        class="btn btn-secondary w-100"
                        disabled>

                        Room Currently Unavailable

                    </button>

                <% } %>

            </div>

        </div>

    <% } else { %>

        <!-- Room Not Found -->

        <div class="text-center py-5">

            <div style="font-size: 60px;">
                🏨
            </div>

            <h3 class="mt-3">
                Room Not Found
            </h3>

            <p class="text-muted">
                The room you're looking for doesn't exist or has been removed.
            </p>

            <a
                href="/api/hotel/rooms"
                class="btn btn-primary">

                Back to Rooms

            </a>

        </div>

    <% } %>

</div>
