<!-- Welcome Banner -->
<div class="card shadow border-0 mb-4"
     style="background:linear-gradient(135deg,#667eea,#764ba2);color:white;">
    <div class="card-body p-5">
        <div class="row align-items-center">
            <div class="col-md-8">
                <h1>Welcome back, <%= user?.name || "Traveler" %> ✈️</h1>
                <p class="mt-3 fs-5">Plan your next stay and explore amazing destinations.</p>
                <a href="/api/guest/hotel" class="btn btn-light mt-3 px-4">Explore Hotels</a>
            </div>
            <div class="col-md-4 text-center">
                <img src="/images/banner/hotel banner image.webp"
                     class="img-fluid"
                     style="max-height:180px;width:100%;"
                     alt="Hotel">
            </div>
        </div>
    </div>
</div>

<!-- Statistics -->
<div class="row g-4 mb-4">
    <div class="col-md-3">
        <div class="card shadow border-0 h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <p class="text-muted mb-1">Total Trips</p>
                        <h2><%= totalTrips %></h2>
                    </div>
                    <div class="fs-1">🏨</div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card shadow border-0 h-100">
            <div class="card-body">
                <div class="d-flex justify-content-between">
                    <div>
                        <p class="text-muted mb-1">Upcoming</p>
                        <h2><%= upcomingCount %></h2>
                    </div>
                    <div class="fs-1">🗓️</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Current Booking -->
<% if (upcomingBooking) { %>
    <div class="card shadow border-0 mb-5">
        <div class="card-body">
            <div class="row align-items-center">
                <div class="col-md-4">
                    <% if (upcomingBooking.roomId?.hotelId?.hotelImage) { %>
                        <img src="/uploads/<%= upcomingBooking.roomId.hotelId.hotelImage %>"
                             class="img-fluid rounded"
                             style="height:200px;width:100%;object-fit:cover;"
                             alt="Hotel Image">
                    <% } else { %>
                        <div class="bg-light rounded d-flex align-items-center justify-content-center"
                             style="height:200px;width:100%;">
                            <span class="text-muted">No Hotel Image</span>
                        </div>
                    <% } %>
                </div>

                <div class="col-md-5">
                    <h3><%= upcomingBooking.roomId?.hotelId?.name || "Hotel" %></h3>
                    <p class="text-muted">
                        📍 <%= upcomingBooking.roomId?.hotelId?.city || "India" %>
                    </p>
                    <p>🛏 <%= upcomingBooking.roomId?.roomType || "Room" %> Room</p>
                    <p>
                        📅
                        <%= new Date(upcomingBooking.checkIn).toLocaleDateString("en-IN") %>
                        -
                        <%= new Date(upcomingBooking.checkOut).toLocaleDateString("en-IN") %>
                    </p>
                    <span class="badge bg-success"><%= upcomingBooking.status %></span>
                </div>

                <div class="col-md-3 text-center">
                    <a href="/api/guest/booking/details/<%= upcomingBooking._id %>"
                       class="btn btn-primary px-4">
                        View Booking
                    </a>
                </div>
            </div>
        </div>
    </div>
<% } else { %>
    <div class="card shadow border-0 mb-5">
        <div class="card-body text-center py-4">
            <h4>No Upcoming Stay 🏝️</h4>
            <p class="text-muted">You don't have any upcoming bookings.</p>
            <a href="/api/guest/hotel" class="btn btn-primary">Browse Rooms</a>
        </div>
    </div>
<% } %>

<!-- Travel Inspiration -->
<div class="container-fluid mt-5">
    <h4 class="fw-bold mb-4">Get inspired for your next trip</h4>

    <%
        const categories = [
            "Heritage cuisine trails",
            "Hill stations and mountains",
            "Cities and cafes"
        ];
    %>

    <% categories.forEach(category => { %>
        <%
            const categoryDestinations = destination.filter(
                item => item.isActive && item.category === category
            );
        %>

        <% if (categoryDestinations.length > 0) { %>
            <h5 class="fw-bold mb-3"><%= category %></h5>

            <div class="row g-3 mb-5">
                <% categoryDestinations.forEach(item => { %>
                    <div class="col-md-3">
                        <a href="/api/guest/rooms?city=<%= encodeURIComponent(item.city) %>"
                           class="text-decoration-none">

                            <div class="position-relative rounded overflow-hidden"
                                 style="height:220px;">

                                <img src="/uploads/<%= item.image %>"
                                     class="w-100 h-100"
                                     style="object-fit:cover;"
                                     alt="<%= item.city %>">

                                <div class="position-absolute top-0 start-0 w-100 h-100"
                                     style="background:linear-gradient(to bottom,rgba(0,0,0,.55),transparent 50%);">
                                </div>

                                <div class="position-absolute top-0 start-0 p-3 text-white">
                                    <small><%= item.country %></small>
                                    <h5 class="fw-bold mb-0"><%= item.city %></h5>
                                </div>
                            </div>
                        </a>
                    </div>
                <% }) %>
            </div>
        <% } %>
    <% }) %>
</div>