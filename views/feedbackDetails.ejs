<div class="container-fluid py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Feedback Details</h2>
            <p class="text-muted mb-0">View complete customer feedback information.</p>
        </div>
        <a href="/api/feedback" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Back
        </a>
    </div>

    <% if (feedback) {
        const types = {
            Complaint: ['bg-danger', 'bi-exclamation-triangle'],
            Inquiry: ['bg-info text-dark', 'bi-question-circle'],
            Feedback: ['bg-primary', 'bi-chat-left-text']
        };

        const statuses = {
            Pending: ['bg-warning text-dark', 'bi-clock'],
            Resolved: ['bg-success', 'bi-check-circle'],
            Rejected: ['bg-danger', 'bi-x-circle']
        };

        const type = types[feedback.messageType] || ['bg-secondary', 'bi-chat'];
        const status = statuses[feedback.status] || ['bg-secondary', 'bi-circle'];
    %>
        <div class="row g-4">
            <!-- Customer Information -->
            <div class="col-lg-4">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body p-4">
                        <!-- Profile -->
                        <div class="text-center mb-4">
                            <div class="rounded-circle bg-primary bg-opacity-10 d-flex align-items-center justify-content-center mx-auto mb-3" style="width:80px;height:80px;">
                                <i class="bi bi-person text-primary fs-2"></i>
                            </div>
                            <h4 class="fw-bold mb-1"><%= feedback.name || 'N/A' %></h4>
                            <p class="text-muted mb-0">Customer</p>
                        </div>

                        <hr>

                        <!-- Customer Details -->
                        <% [
                            ['Name', 'bi-person', feedback.name],
                            ['Email Address', 'bi-envelope', feedback.email],
                            ['Phone Number', 'bi-telephone', feedback.phoneNo]
                        ].forEach(([label, icon, value]) => { %>
                            <div class="mb-3">
                                <small class="text-muted d-block mb-1"><%= label %></small>
                                <div class="fw-semibold">
                                    <i class="bi <%= icon %> me-2"></i>
                                    <%= value || 'N/A' %>
                                </div>
                            </div>
                        <% }) %>

                        <!-- Message Type -->
                        <div class="mb-3">
                            <small class="text-muted d-block mb-1">Message Type</small>
                            <span class="badge <%= type[0] %>">
                                <i class="bi <%= type[1] %> me-1"></i>
                                <%= feedback.messageType || 'N/A' %>
                            </span>
                        </div>

                        <!-- Date -->
                        <div class="mb-3">
                            <small class="text-muted d-block mb-1">Submitted On</small>
                            <div class="fw-semibold">
                                <i class="bi bi-calendar3 me-2"></i>
                                <%= feedback.createdAt
                                    ? new Date(feedback.createdAt).toLocaleString('en-IN', {
                                        day: '2-digit',
                                        month: 'short',
                                        year: 'numeric',
                                        hour: '2-digit',
                                        minute: '2-digit'
                                    })
                                    : 'N/A'
                                %>
                            </div>
                        </div>

                        <!-- Status -->
                        <div>
                            <small class="text-muted d-block mb-2">Current Status</small>
                            <span class="badge <%= status[0] %> px-3 py-2">
                                <i class="bi <%= status[1] %> me-1"></i>
                                <%= feedback.status || 'Unknown' %>
                            </span>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Message -->
            <div class="col-lg-8">
                <div class="card border-0 shadow-sm">
                    <div class="card-header bg-white border-0 p-4">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h5 class="fw-bold mb-1">Customer Message</h5>
                                <p class="text-muted mb-0">Message submitted through the contact form.</p>
                            </div>
                            <span class="badge <%= type[0] %> px-3 py-2">
                                <%= feedback.messageType || 'Feedback' %>
                            </span>
                        </div>
                    </div>

                    <div class="card-body p-4">
                        <!-- Message -->
                        <div class="bg-light rounded-3 p-4 mb-4" style="min-height:200px;">
                            <p class="mb-0" style="line-height:1.8;white-space:pre-wrap;">
                                <%= feedback.message || 'No message provided.' %>
                            </p>
                        </div>

                        <!-- Update Status -->
                        <div class="border-top pt-4">
                            <h6 class="fw-bold mb-3">Update Feedback Status</h6>

                            <form action="/api/feedback/update-status/<%= feedback._id %>" method="POST">
                                <div class="row g-3">
                                    <div class="col-md-7">
                                        <label class="form-label fw-semibold">Status</label>
                                        <select name="status" class="form-select" required>
                                            <option value="">Select Status</option>
                                            <% Object.keys(statuses).forEach(s => { %>
                                                <option value="<%= s %>" <%= feedback.status == s ? 'selected' : '' %>>
                                                    <%= s %>
                                                </option>
                                            <% }) %>
                                        </select>
                                    </div>

                                    <div class="col-md-5">
                                        <label class="form-label fw-semibold">Action</label>
                                        <button type="submit" class="btn btn-primary w-100">
                                            <i class="bi bi-check2-circle me-1"></i>
                                            Update Status
                                        </button>
                                    </div>
                                </div>

                                <!-- Admin Message -->
                                <div class="mt-3">
                                    <label class="form-label fw-semibold">Admin Message</label>
                                    <textarea name="message" class="form-control" rows="3" placeholder="Optional admin message..."></textarea>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    <% } else { %>
        <!-- Not Found -->
        <div class="card border-0 shadow-sm">
            <div class="card-body text-center py-5">
                <i class="bi bi-exclamation-circle text-danger fs-1"></i>
                <h4 class="fw-bold mt-3">Feedback Not Found</h4>
                <p class="text-muted">The requested feedback could not be found.</p>
                <a href="/api/feedback" class="btn btn-primary">
                    Back to Feedback
                </a>
            </div>
        </div>
    <% } %>
</div>