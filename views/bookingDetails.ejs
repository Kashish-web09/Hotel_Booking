<div class="container py-5">
    <div class="mb-4">
        <a href="/api/booking" class="text-decoration-none">← My Bookings</a>
    </div>

    <% if (booking) { %>

        <div class="text-center mb-5">
            <% if (booking.status === "Confirmed") { %>
                <span class="badge bg-success fs-6 px-3 py-2">Booking Confirmed</span>
            <% } else if (booking.status === "Pending") { %>
                <span class="badge bg-warning text-dark fs-6 px-3 py-2">Booking Pending</span>
            <% } else if (booking.status === "Cancelled") { %>
                <span class="badge bg-danger fs-6 px-3 py-2">Booking Cancelled</span>
            <% } else { %>
                <span class="badge bg-secondary fs-6 px-3 py-2"><%= booking.status %></span>
            <% } %>

            <h2 class="mt-3">Booking Details</h2>
            <p class="text-muted mb-0">Your booking information is shown below.</p>
        </div>

        <div class="row g-4">
            <div class="col-lg-5">
                <div class="card shadow-sm border-0">
                    <% if (booking.roomId && booking.roomId.images && booking.roomId.images.length > 0) { %>
                        <img src="/uploads/<%= booking.roomId.images[0] %>"
                             class="card-img-top"
                             style="height:250px; object-fit:cover;"
                             alt="Room">
                    <% } %>

                    <div class="card-body">
                        <% if (booking.roomId) { %>
                            <h4><%= booking.roomId.roomType %> Room</h4>
                            <p class="text-muted">Room <%= booking.roomId.roomNumber %></p>

                            <div class="row g-3 mt-2">
                                <div class="col-6">
                                    <small class="text-muted">Floor</small>
                                    <div><strong><%= booking.roomId.floor %></strong></div>
                                </div>
                                <div class="col-6">
                                    <small class="text-muted">Max Guests</small>
                                    <div><strong><%= booking.roomId.maxGuests %></strong></div>
                                </div>
                            </div>
                        <% } else { %>
                            <p class="text-muted mb-0">Room information unavailable.</p>
                        <% } %>
                    </div>
                </div>
            </div>

            <div class="col-lg-7">
                <div class="card shadow-sm border-0">
                    <div class="card-body p-4">
                        <h4 class="mb-4">Booking Information</h4>

                        <div class="d-flex justify-content-between mb-3">
                            <span class="text-muted">Booking ID</span>
                            <strong><%= booking._id %></strong>
                        </div>

                        <div class="d-flex justify-content-between mb-3">
                            <span class="text-muted">Check In</span>
                            <strong><%= new Date(booking.checkIn).toLocaleDateString() %></strong>
                        </div>

                        <div class="d-flex justify-content-between mb-3">
                            <span class="text-muted">Check Out</span>
                            <strong><%= new Date(booking.checkOut).toLocaleDateString() %></strong>
                        </div>

                        <div class="d-flex justify-content-between mb-3">
                            <span class="text-muted">Guests</span>
                            <strong><%= booking.guests %></strong>
                        </div>

                        <div class="d-flex justify-content-between mb-3">
                            <span class="text-muted">Price per Night</span>
                            <strong>₹<%= booking.pricePerNight %></strong>
                        </div>

                        <hr>

                        <div class="d-flex justify-content-between mb-4">
                            <span class="fs-5">Total Amount</span>
                            <strong class="fs-4">₹<%= booking.totalAmount %></strong>
                        </div>

                        <div class="mb-4">
                            <span class="text-muted d-block mb-2">Booking Status</span>

                            <% if (booking.status === "Confirmed") { %>
                                <span class="badge bg-success">Confirmed</span>
                            <% } else if (booking.status === "Pending") { %>
                                <span class="badge bg-warning text-dark">Pending</span>
                            <% } else if (booking.status === "Cancelled") { %>
                                <span class="badge bg-danger">Cancelled</span>
                            <% } else { %>
                                <span class="badge bg-secondary"><%= booking.status %></span>
                            <% } %>
                        </div>

                        <% if (booking.status === "Pending" || booking.status === "Confirmed") { %>
                            <form action="/api/booking/<%= booking._id %>"
                                  method="POST"
                                  onsubmit="return confirm('Are you sure you want to cancel this booking?')">
                                <button type="submit" class="btn btn-outline-danger w-100">
                                    Cancel Booking
                                </button>
                            </form>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>

    <% } else { %>

        <div class="text-center py-5">
            <div style="font-size:60px;">📋</div>
            <h3 class="mt-3">Booking Not Found</h3>
            <p class="text-muted">We couldn't find the booking you're looking for.</p>
            <a href="/api/booking" class="btn btn-primary">My Bookings</a>
        </div>

    <% } %>
</div>