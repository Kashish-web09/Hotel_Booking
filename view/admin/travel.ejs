<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Travel Destinations</h2>
            <p class="text-muted mb-0">Manage travel inspiration destinations.</p>
        </div>

        <a href="/api/admin/travel/add" class="btn btn-dark">
            <i class="bi bi-plus-circle me-2"></i>
            Add Destination
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <% if (destination && destination.length > 0) { %>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th class="px-4">Image</th>
                                <th>Destination</th>
                                <th>Category</th>
                                <th>Country</th>
                                <th>Status</th>
                                <th class="text-center">Action</th>
                            </tr>
                        </thead>

                        <tbody>
                            <% destination.forEach(item => { %>
                                <tr>
                                    <td class="px-4">
                                        <% if (item.image) { %>
                                            <img
                                                src="/uploads/<%= item.image %>"
                                                alt="<%= item.city %>"
                                                style="width:80px;height:55px;object-fit:cover;border-radius:8px;"
                                            >
                                        <% } else { %>
                                            <div
                                                class="bg-light d-flex align-items-center justify-content-center"
                                                style="width:80px;height:55px;border-radius:8px;"
                                            >
                                                <span class="text-muted small">No Image</span>
                                            </div>
                                        <% } %>
                                    </td>

                                    <td>
                                        <div class="fw-semibold"><%= item.city %></div>
                                    </td>

                                    <td>
                                        <span class="text-muted"><%= item.category %></span>
                                    </td>

                                    <td><%= item.country %></td>

                                    <td>
                                        <% if (item.isActive) { %>
                                            <span class="badge bg-success">Active</span>
                                        <% } else { %>
                                            <span class="badge bg-secondary">Inactive</span>
                                        <% } %>
                                    </td>

                                    <td class="text-center">
                                        <a
                                            href="/api/admin/travel/update/<%= item._id %>"
                                            class="btn btn-sm btn-outline-primary me-1"
                                        >
                                            <i class="bi bi-pencil"></i>
                                            Edit
                                        </a>

                                        <form
                                            action="/api/admin/travel/delete/<%= item._id %>"
                                            method="POST"
                                            class="d-inline"
                                            onsubmit="return confirm('Are you sure you want to delete this destination?');"
                                        >
                                            <button
                                                type="submit"
                                                class="btn btn-sm btn-outline-danger"
                                            >
                                                <i class="bi bi-trash"></i>
                                                Delete
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            <% } else { %>
                <div class="text-center py-5">
                    <div class="fs-1 mb-3">🌍</div>
                    <h5 class="fw-semibold">No destinations found</h5>
                    <p class="text-muted">Start by adding your first travel destination.</p>

                    <a href="/api/admin/travel/add" class="btn btn-dark">
                        <i class="bi bi-plus-circle me-2"></i>
                        Add Destination
                    </a>
                </div>
            <% } %>
        </div>
    </div>
</div>