        "tags": ["Bookings"],
        "summary": "Update Booking Status",
        "description": "Admin only.",
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/Id"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["status"],
                "properties": {
                  "status": {
                    "type": "string",
                    "example": "Confirmed"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Booking status updated successfully"
          }
        }
